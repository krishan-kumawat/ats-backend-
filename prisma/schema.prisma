generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── TypeORM-managed tables (mapped read-only by Prisma) ────────────────────

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique @db.VarChar(255)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  firstName        String    @map("first_name") @db.VarChar(100)
  lastName         String    @map("last_name") @db.VarChar(100)
  isActive         Boolean   @default(true) @map("is_active")
  roleId           String?   @map("role_id") @db.Uuid
  profileId        String    @map("profile_id") @db.Uuid
  departmentId     String?   @map("department_id") @db.Uuid
  refreshTokenHash String?   @map("refresh_token_hash") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp()
  createdById      String?   @map("created_by_id") @db.Uuid
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()
  lastModifiedById String?   @map("last_modified_by_id") @db.Uuid
  deletedAt        DateTime? @map("deleted_at") @db.Timestamp()

  role       Role?       @relation("UserRole", fields: [roleId], references: [id], onDelete: SetNull)
  profile    Profile     @relation("UserProfile", fields: [profileId], references: [id], onDelete: Restrict)
  department Department? @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  creator    User?       @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updater    User?       @relation("UserUpdater", fields: [lastModifiedById], references: [id], onDelete: SetNull)

  createdUsers  User[] @relation("UserCreator")
  updatedUsers  User[] @relation("UserUpdater")

  userPermissionSets UserPermissionSet[]
  ownedJobs          Job[]              @relation("JobOwner")
  createdJobs        Job[]              @relation("JobCreator")
  modifiedJobs       Job[]              @relation("JobModifier")
  ownedCandidates    Candidate[]        @relation("CandidateOwner")
  createdCandidates  Candidate[]        @relation("CandidateCreator")
  modifiedCandidates Candidate[]        @relation("CandidateModifier")
  resourceAccess     UserResourceAccess[]
  auditLogs          AuditLog[]

  @@map("users")
}

model Profile {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  isCustom    Boolean   @default(true) @map("is_custom")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp()
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()
  lastModifiedById String? @map("last_modified_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamp()

  users              User[]              @relation("UserProfile")
  profilePermissions ProfilePermission[]
  permissionSet      PermissionSet?

  @@map("profiles")
}

model Role {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @unique @db.VarChar(100)
  developerName String?   @unique @map("developer_name") @db.VarChar(100)
  parentId      String?   @map("parent_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp()
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()
  lastModifiedById String? @map("last_modified_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamp()

  parent   Role?  @relation("RoleHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Role[] @relation("RoleHierarchy")
  users    User[] @relation("UserRole")

  @@map("roles")
}

model PermissionSet {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String    @unique @db.VarChar(100)
  description        String?   @db.Text
  isCustom           Boolean   @default(true) @map("is_custom")
  isManagedByProfile Boolean   @default(false) @map("is_managed_by_profile")
  profileId          String?   @unique @map("profile_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp()
  createdById        String?   @map("created_by_id") @db.Uuid
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()
  lastModifiedById   String?   @map("last_modified_by_id") @db.Uuid
  deletedAt          DateTime? @map("deleted_at") @db.Timestamp()

  profile             Profile?  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userPermissionSets  UserPermissionSet[]
  permissionSetPerms  PermissionSetPermission[]

  @@map("permission_sets")
}

// ─── Prisma-managed tables (ATS domain + junction tables) ───────────────────

model Department {
  id               String    @id @default(uuid()) @db.Uuid
  name             String    @unique @db.VarChar(255)
  parentId         String?   @map("parent_id") @db.Uuid
  createdById      String?   @map("created_by_id") @db.Uuid
  lastModifiedById String?   @map("last_modified_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()
  deletedAt        DateTime? @map("deleted_at") @db.Timestamp()

  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentHierarchy")
  users    User[]       @relation("UserDepartment")
  jobs     Job[]

  @@map("departments")
}

model Job {
  id               String    @id @default(uuid()) @db.Uuid
  title            String    @db.VarChar(255)
  description      String?   @db.Text
  status           String    @default("Draft") @db.VarChar(50)
  budget           Float?
  workMode         String?   @default("On-site") @map("work_mode") @db.VarChar(50)
  salaryMin        Decimal?  @map("salary_min") @db.Decimal(12, 2)
  salaryMax        Decimal?  @map("salary_max") @db.Decimal(12, 2)
  departmentId     String?   @map("department_id") @db.Uuid
  ownerId          String    @map("owner_id") @db.Uuid
  createdById      String?   @map("created_by_id") @db.Uuid
  lastModifiedById String?   @map("last_modified_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()
  deletedAt        DateTime? @map("deleted_at") @db.Timestamp()

  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  owner          User         @relation("JobOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy      User?        @relation("JobCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastModifiedBy User?        @relation("JobModifier", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  candidateJobs  CandidateJob[]

  @@map("jobs")
}

model Candidate {
  id               String    @id @default(uuid()) @db.Uuid
  firstName        String    @map("first_name") @db.VarChar(255)
  lastName         String    @map("last_name") @db.VarChar(255)
  email            String    @db.VarChar(255)
  phone            String?   @db.VarChar(50)
  skills           String[]  @default([])
  currentLocation  String?   @map("current_location") @db.VarChar(255)
  totalExperience  Decimal?  @map("total_experience") @db.Decimal(4, 1)
  currentCompany   String?   @map("current_company") @db.VarChar(255)
  currentDesignation String? @map("current_designation") @db.VarChar(255)
  linkedinUrl      String?   @map("linkedin_url") @db.VarChar(500)
  source           String    @default("LinkedIn") @db.VarChar(50)
  candidateStatus  String    @default("NEW") @map("candidate_status") @db.VarChar(50)
  resumeUrl        String?   @map("resume_url") @db.VarChar(1000)
  ownerId          String    @map("owner_id") @db.Uuid
  createdById      String?   @map("created_by_id") @db.Uuid
  lastModifiedById String?   @map("last_modified_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()
  deletedAt        DateTime? @map("deleted_at") @db.Timestamp()

  owner          User          @relation("CandidateOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy      User?         @relation("CandidateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastModifiedBy User?         @relation("CandidateModifier", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  candidateJobs  CandidateJob[]

  @@map("candidates")
}

model CandidateJob {
  id               String    @id @default(uuid()) @db.Uuid
  candidateId      String    @map("candidate_id") @db.Uuid
  jobId            String    @map("job_id") @db.Uuid
  status           String    @default("Applied") @db.VarChar(50)
  expectedSalary   Float?    @map("expected_salary")
  proposedSalary   Float?    @map("proposed_salary")
  proposedEquity   Float?    @map("proposed_equity")
  sourceTag        String?   @map("source_tag") @db.VarChar(255)
  technicalScore   Int?      @map("technical_score")
  systemScore      Int?      @map("system_score")
  cultureScore     Int?      @map("culture_score")
  pros             String?   @db.Text
  cons             String?   @db.Text
  recommendation   String?   @db.VarChar(50)
  approvalStatus   String?   @map("approval_status") @db.VarChar(50)
  approvalFeedback String?   @map("approval_feedback") @db.Text
  createdById      String?   @map("created_by_id") @db.Uuid
  lastModifiedById String?   @map("last_modified_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()
  deletedAt        DateTime? @map("deleted_at") @db.Timestamp()

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@map("candidate_jobs")
}

model UserResourceAccess {
  id           String @id @default(uuid()) @db.Uuid
  userId       String @map("user_id") @db.Uuid
  resourceType String @map("resource_type") @db.VarChar(50)
  resourceId   String @map("resource_id") @db.Uuid
  accessLevel  String @default("READ") @map("access_level") @db.VarChar(10)
  sharedVia    String @default("MANUAL") @map("shared_via") @db.VarChar(50)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceType, resourceId])
  @@map("user_resource_access")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(100)
  resourceId   String   @map("resource_id") @db.VarChar(255)
  payload      Json?
  ipAddress    String?  @map("ip_address") @db.VarChar(100)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Permission {
  id       String @id @default(uuid()) @db.Uuid
  module   String @db.VarChar(100)
  resource String @db.VarChar(100)
  action   String @db.VarChar(100)
  code     String @unique @db.VarChar(255)

  profilePermissions      ProfilePermission[]
  permissionSetPermissions PermissionSetPermission[]

  @@map("permissions")
}

model ProfilePermission {
  id           String @id @default(uuid()) @db.Uuid
  profileId    String @map("profile_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  profile    Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([profileId, permissionId])
  @@map("profile_permissions")
}

model PermissionSetPermission {
  id              String @id @default(uuid()) @db.Uuid
  permissionSetId String @map("permission_set_id") @db.Uuid
  permissionId    String @map("permission_id") @db.Uuid

  permissionSet PermissionSet @relation(fields: [permissionSetId], references: [id], onDelete: Cascade)
  permission    Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([permissionSetId, permissionId])
  @@map("permission_set_permissions")
}

model UserPermissionSet {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @map("user_id") @db.Uuid
  permissionSetId String @map("permission_set_id") @db.Uuid

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionSet PermissionSet @relation(fields: [permissionSetId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionSetId])
  @@map("user_permission_sets")
}


